<mxfile host="app.diagrams.net" modified="2026-04-11T00:00:00.000Z" agent="draw.io" version="24.0.0" type="device">
  <diagram id="annotation_algo" name="Annotation Algorithm Flowchart">
    <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="generate_annotation() — Annotation Algorithm Flowchart" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="550" height="40" as="geometry"/>
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="START&#xa;generate_annotation(query, bundle)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- === SCAN BRANCH === -->
        <mxCell id="scan_header" value="PHASE 1: Scan Analysis" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#E3F2FD;rounded=1;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="180" width="220" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="extract_tables" value="extract_table_aliases(query)&#xa;&#xa;Parse SQL to get&#xa;(table_name, alias) pairs&#xa;via sqlglot or regex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="collect_scans" value="_collect_scan_info(plan_json)&#xa;&#xa;DFS over plan tree&#xa;Filter nodes with &quot;Scan&quot; in type&#xa;Extract: type, relation, alias,&#xa;index, filter, costs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="scan_loop" value="FOR each (table, alias)&#xa;in extracted tables:" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;perimeter=hexagonPerimeter2;size=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="475" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="match_scan" value="Match table to scan node&#xa;by alias or relation name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="555" width="180" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="is_seqscan" value="Is scan type&#xa;Seq Scan?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="seqscan_yes" value="Find AQP where&#xa;enable_seqscan = off&#xa;&#xa;ratio = AQP_cost / QEP_cost&#xa;&#xa;ratio &gt; 1.5?&#xa;→ &quot;Alt scans increase cost by Nx&quot;&#xa;else → &quot;No suitable index exists&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="20" y="740" width="200" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="seqscan_no" value="Index scan?&#xa;→ &quot;Index used: X&quot;&#xa;&#xa;Has filter?&#xa;→ append filter info" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="250" y="740" width="150" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="scan_note_out" value="Append scan note:&#xa;&quot;Table X is accessed&#xa;using [scan type].&#xa;[reason]&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="900" width="180" height="70" as="geometry"/>
        </mxCell>

        <!-- === JOIN BRANCH === -->
        <mxCell id="join_header" value="PHASE 2: Join Analysis" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#C8E6C9;rounded=1;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="180" width="220" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="collect_joins" value="_collect_join_info(plan_json)&#xa;&#xa;DFS over plan tree&#xa;Filter: Hash Join, Merge Join,&#xa;Nested Loop&#xa;Extract: type, condition, costs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="210" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="join_loop" value="FOR each join node:" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;perimeter=hexagonPerimeter2;size=15;" vertex="1" parent="1">
          <mxGeometry x="460" y="365" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="join_note" value="Generate note:&#xa;&quot;The [join_type] join on&#xa;[condition] is implemented&#xa;using [operator].&#xa;Estimated output: N rows.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="435" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- === REASONING BRANCH === -->
        <mxCell id="reason_header" value="PHASE 3: Cost Reasoning" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#FFF9C4;rounded=1;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="550" width="220" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="reason_loop" value="FOR each unique join&#xa;operator in QEP:" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;perimeter=hexagonPerimeter2;size=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="600" width="190" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="find_disabled" value="Find AQP where this&#xa;operator is disabled&#xa;&#xa;ratio = AQP_cost / baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="680" width="190" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="find_others" value="FOR each OTHER join method:&#xa;  alt_aqp = find disabled AQP&#xa;  alt_ratio = alt_cost / baseline&#xa;  if alt_ratio &gt; 1.05:&#xa;    add to comparisons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="780" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ratio_check" value="ratio &gt; 1.05?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="890" width="130" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="reason_preferred" value="&quot;[OP] is preferred.&#xa;Disabling it increases cost&#xa;from X to Y (Nx).&#xa;Similarly, disabling [ALT]&#xa;increases cost by Mx.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="990" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="reason_similar" value="&quot;[OP] and [ALT] have&#xa;similar estimated costs.&#xa;Choice influenced by&#xa;row counts and data&#xa;distribution.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="990" width="170" height="90" as="geometry"/>
        </mxCell>

        <!-- === OTHER OPS BRANCH === -->
        <mxCell id="other_header" value="PHASE 4: Other Operations" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#F8CECC;rounded=1;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="790" y="180" width="220" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="collect_others" value="_collect_other_ops(plan_json)&#xa;&#xa;DFS: Sort, Aggregate,&#xa;HashAggregate, GroupAggregate,&#xa;Limit, Materialize, Gather" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="230" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="other_loop" value="FOR each operation:" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;perimeter=hexagonPerimeter2;size=15;" vertex="1" parent="1">
          <mxGeometry x="820" y="355" width="150" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="other_dispatch" value="Sort → &quot;Sort orders by [key]&quot;&#xa;Aggregate → &quot;Groups by [key]&quot;&#xa;Limit → &quot;Caps result set&quot;&#xa;Materialize → &quot;Caches results&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="425" width="210" height="70" as="geometry"/>
        </mxCell>

        <!-- === INLINE MAPPING === -->
        <mxCell id="inline_header" value="PHASE 5: Inline Mapping" style="text;html=1;fontSize=13;fontStyle=5;align=center;fillColor=#E1D5E7;rounded=1;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="790" y="550" width="220" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="find_clauses" value="Find SQL clause ranges:&#xa;&#xa;FROM range → scan_notes&#xa;WHERE range → join + reasoning&#xa;ORDER BY range → sort notes&#xa;GROUP BY range → agg notes&#xa;SELECT line → other notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="600" width="210" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="create_inline" value="Create InlineAnnotation objects:&#xa;&#xa;InlineAnnotation(&#xa;  start_line, end_line,&#xa;  category, text&#xa;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="740" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- === FINAL OUTPUT === -->
        <mxCell id="merge_all" value="Combine all notes:&#xa;&#xa;component_notes = scan + join + other&#xa;all_notes = component + reasoning&#xa;&#xa;Build plain-text comment block&#xa;Build StructuredAnnotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="870" width="230" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="end" value="RETURN&#xa;AnnotationResult" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="1010" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- === EDGES === -->
        <mxCell id="e_start_scan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" parent="1" source="start" target="extract_tables">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="110"/>
              <mxPoint x="350" y="160"/>
              <mxPoint x="160" y="160"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_start_join" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" parent="1" source="start" target="collect_joins">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_start_other" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" parent="1" source="start" target="collect_others">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="110"/>
              <mxPoint x="750" y="160"/>
              <mxPoint x="895" y="160"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_et_cs" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="extract_tables" target="collect_scans">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_cs_sl" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="collect_scans" target="scan_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_sl_ms" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="scan_loop" target="match_scan">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ms_is" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="match_scan" target="is_seqscan">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_is_yes" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="is_seqscan" target="seqscan_yes">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_is_yes_label" value="Yes" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" vertex="1" connectable="0" parent="e_is_yes">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_is_no" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="is_seqscan" target="seqscan_no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_is_no_label" value="No" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" vertex="1" connectable="0" parent="e_is_no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_sy_out" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="seqscan_yes" target="scan_note_out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_sn_out" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="seqscan_no" target="scan_note_out">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="325" y="870"/>
              <mxPoint x="170" y="870"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_cj_jl" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="collect_joins" target="join_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_jl_jn" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="join_loop" target="join_note">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_jn_rl" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="join_note" target="reason_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_rl_fd" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="reason_loop" target="find_disabled">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_fd_fo" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="find_disabled" target="find_others">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_fo_rc" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="find_others" target="ratio_check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_rc_pref" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="ratio_check" target="reason_preferred">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_rc_pref_label" value="Yes" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" vertex="1" connectable="0" parent="e_rc_pref">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_rc_sim" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="ratio_check" target="reason_similar">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_rc_sim_label" value="No" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" vertex="1" connectable="0" parent="e_rc_sim">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_ol_od" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="collect_others" target="other_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_od_od" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="other_loop" target="other_dispatch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_od_fc" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="other_dispatch" target="find_clauses">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_fc_ci" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="find_clauses" target="create_inline">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ci_ma" style="rounded=1;strokeWidth=1.5;" edge="1" parent="1" source="create_inline" target="merge_all">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Connect scan + reasoning outputs to merge -->
        <mxCell id="e_sno_ma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="scan_note_out" target="merge_all">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="1000"/>
              <mxPoint x="170" y="1100"/>
              <mxPoint x="760" y="1100"/>
              <mxPoint x="760" y="920"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_rp_ma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="reason_preferred" target="merge_all">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="440" y="1110"/>
              <mxPoint x="760" y="1110"/>
              <mxPoint x="760" y="920"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_ma_end" style="rounded=1;strokeWidth=2;" edge="1" parent="1" source="merge_all" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
